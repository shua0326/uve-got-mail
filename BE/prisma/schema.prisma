// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider      = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
  previewFeatures = ["relationJoins"]
  binaryTargets = ["native"]
}

datasource db {
  provider = "postgresql"
}

model MailUser {
  id            String @id
  email         String @unique
  username      String @unique @default("")
  friends       MailUser[] @relation("Friends")
  friendOf      MailUser[] @relation("Friends")
  sent          Mail[] @relation("sender")
  received      Mail[] @relation("recipient")
  scheduledMail DateTime?
}

model Mail {
  id          Int      @id @default(autoincrement())
  sentAt      DateTime @default(now())
  read        Boolean  @default(false)
  received    Boolean  @default(false)

  senderId    String
  sender      MailUser     @relation("sender", fields: [senderId], references: [id])

  recipientId String
  recipient   MailUser     @relation("recipient", fields: [recipientId], references: [id])

  historyId   String
  history     History  @relation("history", fields: [historyId], references: [id])

  recordingId String    @unique
  recording   Recording @relation(fields: [recordingId], references: [id])
}

model Recording {
  id        String   @id @default(uuid())
  data      Bytes
  byteSize  Int
  createdAt DateTime @default(now())
  mail      Mail?
}

model History {
  id    String    @id
  mails Mail[] @relation("history")
}

