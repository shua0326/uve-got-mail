# Copy to .env and fill in. Never commit the filled-in file.

# Postgres connection string. From Supabase: Project Settings -> Database.
DATABASE_URL=postgresql://user:password@host:5432/postgres

# Supabase project URL and anon key, used to verify incoming bearer tokens.
# Project Settings -> API.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Powers the GIF picker. https://developers.giphy.com/
GIPHY_API_KEY=your-giphy-api-key

# Shared secret guarding the manual delivery trigger (POST /delivery/run).
# Generate one with: openssl rand -hex 32
# If this is unset the route fails closed with a 503.
DELIVERY_SECRET=

# Port the server listens on. Defaults to 3000 if unset.
# docker-compose.yml overrides this to 8888; the Vite dev proxy reads the
# value from this file, so keep the two in sync when running locally.
PORT=8888
