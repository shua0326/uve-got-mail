# Copy to .env and fill in. Never commit the filled-in file.
#
# These are inlined by Vite at BUILD time, not read at runtime, so they must be
# set before `npm run build` — not just before `npm run dev`.

# Same Supabase project as the backend. Project Settings -> API.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional. Removes the tldraw watermark from the letter canvas.
# The app runs fine without it.
# VITE_TLDRAW_LICENSE_KEY=
